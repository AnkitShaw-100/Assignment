# PostgreSQL credentials used by docker-compose.yml (placeholders — change them).
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadflow
POSTGRES_PORT=5432

# Connection string used by Prisma and the Next.js app.
# When running the app inside Docker Compose, the host is overridden to "db".
DATABASE_URL="postgresql://leadflow:change-me@localhost:5432/leadflow?schema=public"

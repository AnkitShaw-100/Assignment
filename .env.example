# ── Supabase (primary database) ─────────────────────────────────────────────
# Copy both strings from Supabase → your project → "Connect" → ORMs/Prisma,
# replacing [YOUR-PASSWORD] with the database password.

# App runtime: Supavisor transaction-mode pooler (port 6543).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI (migrations, seed): Supavisor session-mode pooler (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ── Local PostgreSQL (tests / offline development) ──────────────────────────
# Started with `docker compose up -d db`. Tests delete all rows, so they only
# ever run against TEST_DATABASE_URL — never against Supabase.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=leadflow
POSTGRES_PORT=5432
TEST_DATABASE_URL="postgresql://leadflow:change-me@localhost:5432/leadflow_test?schema=public"

# Host port for the containerised app (docker compose --profile app up)
APP_PORT=3000
